<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  A manuscript to send to an editor, as the ODT and the PDF make it: A4, 12pt, double-spaced, indented paragraphs,
  wide margins, and the authors, the book's title and the page number on every page. The text uses named styles
  (Body Text, First Paragraph, Heading 1…), so an editor can restyle the whole text by changing one. Where Word has a
  style of its own for the same purpose, the manuscript uses it.
  Liberation Serif is named but not embedded: where it is missing, the reader's own serif takes its place.
  Word measures spacing in twentieths of a point (567 to the centimetre; a line of 240 is single) and type in half
  points. The language is filled in when the file is made.
-->
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
    <w:docDefaults>
        <w:rPrDefault>
            <w:rPr>
                <w:rFonts w:ascii="Liberation Serif" w:hAnsi="Liberation Serif" w:eastAsia="Liberation Serif"
                          w:cs="Liberation Serif"/>
                <w:color w:val="000000"/>
                <w:sz w:val="24"/>
                <w:szCs w:val="24"/>
                <w:lang w:val="{{language}}"/>
            </w:rPr>
        </w:rPrDefault>
        <w:pPrDefault>
            <w:pPr>
                <w:widowControl/>
                <w:spacing w:before="0" w:after="0" w:line="240" w:lineRule="auto"/>
            </w:pPr>
        </w:pPrDefault>
    </w:docDefaults>

    <w:style w:type="paragraph" w:default="1" w:styleId="Normal">
        <w:name w:val="Normal"/>
        <w:qFormat/>
    </w:style>

    <w:style w:type="character" w:default="1" w:styleId="DefaultParagraphFont">
        <w:name w:val="Default Paragraph Font"/>
        <w:uiPriority w:val="1"/>
        <w:semiHidden/>
        <w:unhideWhenUsed/>
    </w:style>

    <w:style w:type="paragraph" w:styleId="BodyText">
        <w:name w:val="Body Text"/>
        <w:basedOn w:val="Normal"/>
        <w:qFormat/>
        <w:pPr>
            <w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="auto"/>
            <w:ind w:firstLine="709"/>
            <w:jc w:val="left"/>
        </w:pPr>
    </w:style>

    <!-- The first paragraph of the chapter, and the one after a heading, a scene break, a quote or a list. -->
    <w:style w:type="paragraph" w:styleId="FirstParagraph">
        <w:name w:val="First Paragraph"/>
        <w:basedOn w:val="BodyText"/>
        <w:next w:val="BodyText"/>
        <w:qFormat/>
        <w:pPr>
            <w:ind w:firstLine="0"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Quotations">
        <w:name w:val="Quotations"/>
        <w:basedOn w:val="BodyText"/>
        <w:qFormat/>
        <w:pPr>
            <w:ind w:left="709" w:right="709" w:firstLine="0"/>
        </w:pPr>
    </w:style>

    <!-- A paragraph in a list item; the list's numbering draws its bullet or number and indents it. -->
    <w:style w:type="paragraph" w:styleId="List">
        <w:name w:val="List"/>
        <w:basedOn w:val="BodyText"/>
        <w:pPr>
            <w:ind w:firstLine="0"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="SceneBreak">
        <w:name w:val="Scene Break"/>
        <w:basedOn w:val="BodyText"/>
        <w:next w:val="FirstParagraph"/>
        <w:qFormat/>
        <w:pPr>
            <w:ind w:firstLine="0"/>
            <w:jc w:val="center"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Figure">
        <w:name w:val="Figure"/>
        <w:basedOn w:val="BodyText"/>
        <w:pPr>
            <w:ind w:firstLine="0"/>
            <w:jc w:val="center"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="PreformattedText">
        <w:name w:val="Preformatted Text"/>
        <w:basedOn w:val="Normal"/>
        <w:pPr>
            <w:spacing w:before="0" w:after="0" w:line="360" w:lineRule="auto"/>
        </w:pPr>
        <w:rPr>
            <w:rFonts w:ascii="Liberation Mono" w:hAnsi="Liberation Mono" w:cs="Liberation Mono"/>
            <w:sz w:val="21"/>
            <w:szCs w:val="21"/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Heading">
        <w:name w:val="Heading"/>
        <w:basedOn w:val="Normal"/>
        <w:next w:val="FirstParagraph"/>
        <w:pPr>
            <w:keepNext/>
            <w:spacing w:before="238" w:after="0" w:line="480" w:lineRule="auto"/>
        </w:pPr>
    </w:style>

    <!-- The chapter's title, a third of the way down its first page. -->
    <w:style w:type="paragraph" w:styleId="Heading1">
        <w:name w:val="heading 1"/>
        <w:basedOn w:val="Heading"/>
        <w:next w:val="FirstParagraph"/>
        <w:qFormat/>
        <w:pPr>
            <w:spacing w:before="2268" w:after="850" w:line="336" w:lineRule="auto"/>
            <w:jc w:val="center"/>
            <w:outlineLvl w:val="0"/>
        </w:pPr>
        <w:rPr>
            <w:sz w:val="32"/>
            <w:szCs w:val="32"/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Heading2">
        <w:name w:val="heading 2"/>
        <w:basedOn w:val="Heading"/>
        <w:next w:val="FirstParagraph"/>
        <w:qFormat/>
        <w:pPr>
            <w:outlineLvl w:val="1"/>
        </w:pPr>
        <w:rPr>
            <w:b/>
            <w:bCs/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Heading3">
        <w:name w:val="heading 3"/>
        <w:basedOn w:val="Heading"/>
        <w:next w:val="FirstParagraph"/>
        <w:qFormat/>
        <w:pPr>
            <w:outlineLvl w:val="2"/>
        </w:pPr>
        <w:rPr>
            <w:i/>
            <w:iCs/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Heading4">
        <w:name w:val="heading 4"/>
        <w:basedOn w:val="Heading"/>
        <w:next w:val="FirstParagraph"/>
        <w:qFormat/>
        <w:pPr>
            <w:outlineLvl w:val="3"/>
        </w:pPr>
        <w:rPr>
            <w:i/>
            <w:iCs/>
        </w:rPr>
    </w:style>

    <!-- The whole book's title page, as in the PDF. -->
    <w:style w:type="paragraph" w:styleId="Cover">
        <w:name w:val="Cover"/>
        <w:basedOn w:val="Normal"/>
        <w:pPr>
            <w:spacing w:before="1134" w:after="850"/>
            <w:jc w:val="center"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Title">
        <w:name w:val="Title"/>
        <w:basedOn w:val="Normal"/>
        <w:next w:val="Subtitle"/>
        <w:qFormat/>
        <w:pPr>
            <w:spacing w:after="227" w:line="336" w:lineRule="auto"/>
            <w:jc w:val="center"/>
        </w:pPr>
        <w:rPr>
            <w:sz w:val="48"/>
            <w:szCs w:val="48"/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Subtitle">
        <w:name w:val="Subtitle"/>
        <w:basedOn w:val="Normal"/>
        <w:qFormat/>
        <w:pPr>
            <w:spacing w:after="227" w:line="336" w:lineRule="auto"/>
            <w:jc w:val="center"/>
        </w:pPr>
        <w:rPr>
            <w:i/>
            <w:iCs/>
            <w:sz w:val="30"/>
            <w:szCs w:val="30"/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="BookAuthors">
        <w:name w:val="Book Authors"/>
        <w:basedOn w:val="Normal"/>
        <w:pPr>
            <w:spacing w:before="567" w:line="336" w:lineRule="auto"/>
            <w:jc w:val="center"/>
        </w:pPr>
        <w:rPr>
            <w:sz w:val="28"/>
            <w:szCs w:val="28"/>
        </w:rPr>
    </w:style>

    <!-- The whole book's contents, after the title page: a line per chapter, linked to it. -->
    <w:style w:type="paragraph" w:styleId="TOCHeading">
        <w:name w:val="TOC Heading"/>
        <w:basedOn w:val="Normal"/>
        <w:next w:val="TOC1"/>
        <w:pPr>
            <w:keepNext/>
            <w:spacing w:before="2268" w:after="850" w:line="336" w:lineRule="auto"/>
            <w:jc w:val="center"/>
        </w:pPr>
        <w:rPr>
            <w:sz w:val="32"/>
            <w:szCs w:val="32"/>
        </w:rPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="TOC1">
        <w:name w:val="toc 1"/>
        <w:basedOn w:val="Normal"/>
        <w:pPr>
            <w:spacing w:line="480" w:lineRule="auto"/>
        </w:pPr>
    </w:style>

    <w:style w:type="paragraph" w:styleId="Header">
        <w:name w:val="header"/>
        <w:basedOn w:val="Normal"/>
        <w:pPr>
            <w:tabs>
                <w:tab w:val="right" w:pos="9072"/>
            </w:tabs>
        </w:pPr>
        <w:rPr>
            <w:color w:val="555555"/>
            <w:sz w:val="20"/>
            <w:szCs w:val="20"/>
        </w:rPr>
    </w:style>

    <w:style w:type="character" w:styleId="Emphasis">
        <w:name w:val="Emphasis"/>
        <w:qFormat/>
        <w:rPr>
            <w:i/>
            <w:iCs/>
        </w:rPr>
    </w:style>

    <w:style w:type="character" w:styleId="Strong">
        <w:name w:val="Strong"/>
        <w:qFormat/>
        <w:rPr>
            <w:b/>
            <w:bCs/>
        </w:rPr>
    </w:style>

    <w:style w:type="character" w:styleId="SourceText">
        <w:name w:val="Source Text"/>
        <w:rPr>
            <w:rFonts w:ascii="Liberation Mono" w:hAnsi="Liberation Mono" w:cs="Liberation Mono"/>
            <w:sz w:val="21"/>
            <w:szCs w:val="21"/>
        </w:rPr>
    </w:style>

    <w:style w:type="character" w:styleId="Hyperlink">
        <w:name w:val="Hyperlink"/>
        <w:rPr>
            <w:color w:val="0563C1"/>
            <w:u w:val="single"/>
        </w:rPr>
    </w:style>

    <!-- A contents line's link to its chapter, in the text's own colour, as in the PDF. -->
    <w:style w:type="character" w:styleId="IndexLink">
        <w:name w:val="Index Link"/>
        <w:rPr>
            <w:color w:val="000000"/>
            <w:u w:val="none"/>
        </w:rPr>
    </w:style>
</w:styles>
