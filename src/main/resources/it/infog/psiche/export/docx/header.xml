<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The page header: the authors and the book's title, then the page number at the right margin. Word
     works the page number out itself, as it lays the pages out. -->
<w:hdr xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
<w:p><w:pPr><w:pStyle w:val="Header"/></w:pPr><w:r><w:t xml:space="preserve">{{header}}</w:t></w:r><w:r><w:tab/></w:r><w:fldSimple w:instr=" PAGE "><w:r><w:t>1</w:t></w:r></w:fldSimple></w:p>
</w:hdr>
